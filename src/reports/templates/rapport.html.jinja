<!DOCTYPE html>
<html lang="fr">
<head><meta charset="utf-8"><title>Rapport de collecte — {{ source }}</title>
<style>
  body { font-family: Calibri, sans-serif; color: #1E293B; margin: 2em; }
  h1 { color: #028090; } table { border-collapse: collapse; width: 100%; }
  th, td { border: 1px solid #CBD5E1; padding: 6px 10px; text-align: left; }
  th { background: #1E293B; color: white; }
</style></head>
<body>
  <h1>Rapport de collecte — {{ source }}</h1>
  <p>Généré le {{ timestamp }}</p>
  <h2>Volumétrie</h2>
  <p>{{ nb_lignes }} enregistrements, {{ nb_categories }} catégories.</p>
  <h2>Qualité</h2>
  <table><tr><th>Champ</th><th>Valides</th><th>Invalides</th></tr>
  {% for cle, r in validation.items() %}
    <tr><td>{{ cle }}</td><td>{{ r.valides }}</td><td>{{ r.invalides }}</td></tr>
  {% endfor %}
  </table>
    <h2>Données extraites</h2>
  <table>
    <tr><th>Catégorie</th><th>Clé</th><th>Valeur</th></tr>
    {% for ligne in lignes %}
    <tr><td>{{ ligne.categorie }}</td><td>{{ ligne.cle }}</td><td>{{ ligne.valeur }}</td></tr>
    {% endfor %}
  </table>
</body></html>
